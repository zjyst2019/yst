# ==============================================================
# eVS Wiki — 环境变量配置
# 复制此文件为 .env 后修改实际值，启动时自动加载
# ==============================================================

# --- 服务器 ---
PORT=3000

# --- 知识库 ---
# 知识库工作目录（必填，CLI 在此目录下执行，读取文档和写入摄入内容）
CLAUDE_WORK_DIR=/path/to/knowledge-base

# 系统提示文件路径（CLAUDE.md，定义知识库结构和格式化规范）
SYSTEM_PROMPT_FILE=/path/to/knowledge-base/CLAUDE.md

# --- CLI 行为控制 ---
# 是否启用对话历史上下文（true=启用，false=每条消息独立无上下文）
ENABLE_HISTORY=false

# 是否启用 hooks（true=启用，false=跳过 --bare）
ENABLE_HOOKS=false

# 是否启用权限检查（true=启用，false=跳过权限校验）
ENABLE_PERMISSIONS=false

# 是否启用工具调用 Read/Bash（true=启用，false=禁用工具）
ENABLE_TOOLS=false

# 最大历史消息条数（ENABLE_HISTORY=false 时无效）
MAX_HISTORY_MESSAGES=5

# root 用户下 Claude CLI 运行用户（非 root 启动时不需设置）
# CLAUDE_RUN_USER=claudeuser

# --- Embedding 向量匹配（可选，需安装 Ollama） ---
USE_EMBEDDING=false

OLLAMA_URL=http://localhost:11434

# 中文推荐 qwen3-embedding:0.6b，英文推荐 nomic-embed-text
EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- 问答缓存控制 ---
# 最大缓存条目数（超过后 LRU 淘汰）
CACHE_MAX_SIZE=500

# 问题相似度阈值（0-1，达到该值命中缓存，直接返回缓存答案）
CACHE_QUESTION_SIMILARITY=0.88

# 回答相似度 ≥ 此值：自动关联新问题到已有缓存
CACHE_ANSWER_HIGH=0.95

# 回答相似度 ≥ 此值：提示用户确认合并答案
CACHE_ANSWER_MERGE=0.90

# 答案 Embedding 截断：取头部 N 个字符
CACHE_ANSWER_HEAD_LEN=250

# 答案 Embedding 截断：取尾部 N 个字符（头+尾拼接后计算向量）
CACHE_ANSWER_TAIL_LEN=250

# Embedding LRU 缓存大小（避免重复调用 Ollama）
CACHE_EMBEDDING_LRU_SIZE=200

# 缓存写入磁盘防抖延迟（毫秒）
CACHE_SAVE_DEBOUNCE_MS=500

# --- 知识库摄入 ---
# 文件摄入上传目录（默认 <工作目录>/upload）
# KNOWLEDGE_UPLOAD_DIR=/path/to/knowledge-base/upload
